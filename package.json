{
  "name": "linguareader",
  "version": "1.2.2",
  "description": "Cross-platform PDF reader with translation and vocabulary learning",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "node scripts/fetch-ocr-models.mjs --optional",
    "dev": "concurrently \"vite\" \"npm run electron:dev\"",
    "electron:dev": "tsc -p tsconfig.electron.json && electron .",
    "prebuild": "node scripts/fetch-ocr-models.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "build:linux": "npm run build && electron-builder --linux",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:all": "npm run build && electron-builder --linux --win --mac",
    "test": "node --test test/*.test.ts",
    "fetch-ocr-models": "node scripts/fetch-ocr-models.mjs"
  },
  "keywords": [
    "pdf",
    "translation",
    "learning",
    "vocabulary"
  ],
  "homepage": "https://github.com/yusufdinc974/LinguaReader",
  "author": {
    "name": "Yusuf Dinc",
    "email": "yusufdinc974@github.com"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "lucide-react": "^0.469.0",
    "onnxruntime-node": "^1.31.1",
    "pdfjs-dist": "^6.5.438",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "recharts": "^2.15.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^9.2.5",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.8"
  },
  "build": {
    "appId": "com.linguareader.app",
    "productName": "LinguaReader",
    "icon": "icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules/better-sqlite3/{deps,src}/**"
    ],
    "extraResources": [
      {
        "from": "icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/ocr",
        "to": "ocr",
        "filter": [
          "*.onnx",
          "*.txt"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "icon.png",
      "executableName": "LinguaReader",
      "maintainer": "Yusuf Dinc <yusufdinc974@github.com>",
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**/libonnxruntime_providers_{cuda,tensorrt}.so",
        "!node_modules/better-sqlite3/{deps,src}/**",
        "!node_modules/better-sqlite3/prebuilds/darwin*",
        "!node_modules/better-sqlite3/prebuilds/win32*"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png",
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/darwin/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
        "!node_modules/better-sqlite3/{deps,src}/**",
        "!node_modules/better-sqlite3/prebuilds/darwin*",
        "!node_modules/better-sqlite3/prebuilds/linux*"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yusufdinc974",
        "repo": "LinguaReader"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "files": [
        "dist/**/*",
        "dist-electron/**/*",
        "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
        "!node_modules/better-sqlite3/{deps,src}/**",
        "!node_modules/better-sqlite3/prebuilds/win32*",
        "!node_modules/better-sqlite3/prebuilds/linux*"
      ]
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "npmRebuild": false,
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
